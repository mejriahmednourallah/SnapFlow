# Backend Configuration
# Copy this file to .env and update the values

# Docker Configuration (for Traefik multi-tenant mode)
# =====================================================
# For Windows + Docker Desktop: Use TCP endpoint
# DOCKER_ENDPOINT=tcp://host.docker.internal:2375
# DOCKER_SOCKET=/dev/null

# For Linux/macOS/Codespaces: Use Unix socket (default)
# DOCKER_ENDPOINT=unix:///var/run/docker.sock
# DOCKER_SOCKET=/var/run/docker.sock

# Database Configuration
# For PostgreSQL (recommended for production):
DATABASE_URL=postgresql://snapflow_user:snapflow_password_change_me@localhost:5432/snapflow_db

# For SQLite (development only):
# DATABASE_URL=sqlite:///./test.db

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Stripe Configuration (optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key_here

# Application Settings
DEBUG=False
HOST=0.0.0.0
PORT=8000

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Email Configuration (optional)
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@snapflow.local
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com


STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=re 0