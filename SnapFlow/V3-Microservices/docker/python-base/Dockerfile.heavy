FROM snapflow/v3-python-browser-base:latest
# Visual regression / LPIPS only. NLP and browser services use separate bases.

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /opt/base
COPY requirements.heavy.txt .
RUN pip install --upgrade setuptools==83.0.0 wheel==0.46.2 jaraco.context==6.1.0 \
    && pip install --no-cache-dir --default-timeout=300 --retries=10 -r requirements.heavy.txt \
    && pip install --upgrade --no-cache-dir setuptools==83.0.0 wheel==0.46.2 jaraco.context==6.1.0 \
    && python -c "import pathlib, shutil, site; [shutil.rmtree(p, ignore_errors=True) for b in site.getsitepackages() for n in ('**/wheel-0.45.1.dist-info','**/jaraco.context-5.3.0.dist-info') for p in pathlib.Path(b).glob(n)]"

WORKDIR /app
