# Copy to k8s/07-secrets/snapflow-secrets.yaml and replace placeholders.
apiVersion: v1
kind: Secret
metadata:
  name: snapflow-secrets
  namespace: snapflow-prod
type: Opaque
stringData:
  # Database settings consumed by v3-aggregator, v3-scanner-go, v3-nlp-worker
  db_host: "pgbouncer.snapflow-infra.svc.cluster.local"
  db_port: "5432"
  db_name: "snapflow"
  db_user: "snapflow"
  db_pass: "REPLACE_WITH_STRONG_PASSWORD"

  # Internal service URLs consumed by v3-aggregator
  scanner_api_url: "http://v3-scanner-go.snapflow-prod.svc.cluster.local:8081"
  visual_regression_api_url: "http://v3-visual-regression.snapflow-prod.svc.cluster.local:8083"

  # Full DSN consumed by v3-visual-regression
  database_url: "postgresql://snapflow:REPLACE_WITH_STRONG_PASSWORD@pgbouncer.snapflow-infra.svc.cluster.local:5432/snapflow"
